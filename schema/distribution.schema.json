{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/FOP-Oksana-Dubinetska/code-constitution/schema/distribution.schema.json",
  "type": "object",
  "required": ["schemaVersion", "source", "parts"],
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "const": "1.0.0" },
    "source": { "type": "string" },
    "parts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["path", "ids", "sha256"],
        "properties": {
          "path": { "type": "string" },
          "ids": {
            "type": "array",
            "items": { "type": "string", "pattern": "^kc-[0-9]{4}$" },
            "uniqueItems": true
          },
          "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
