{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/FOP-Oksana-Dubinetska/code-constitution/schema/locale.schema.json",
  "type": "object",
  "required": [
    "code",
    "status",
    "sourceLocale",
    "sourceSha256",
    "translator",
    "reviewer",
    "lastStructuralCheck",
    "lastSubstantiveReview",
    "responsibleRole"
  ],
  "properties": {
    "$schema": { "type": "string" },
    "code": { "enum": ["ru", "uk", "en"] },
    "status": { "enum": ["normative", "planned", "candidate", "informative"] },
    "sourceLocale": { "type": ["string", "null"] },
    "sourceSha256": {
      "type": ["string", "null"],
      "pattern": "^[a-f0-9]{64}$"
    },
    "translator": { "type": ["string", "null"], "minLength": 1 },
    "reviewer": { "type": ["string", "null"], "minLength": 1 },
    "lastStructuralCheck": {
      "type": ["string", "null"],
      "format": "date"
    },
    "lastSubstantiveReview": {
      "type": ["string", "null"],
      "format": "date"
    },
    "responsibleRole": { "type": "string", "minLength": 1 }
  },
  "additionalProperties": false
}
