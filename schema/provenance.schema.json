{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/FOP-Oksana-Dubinetska/code-constitution/schema/provenance.schema.json",
  "type": "object",
  "required": [
    "schemaVersion",
    "source",
    "sourceSha256",
    "provisionNamespace",
    "provisionCount",
    "derivedFrom",
    "retiredIds"
  ],
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "const": "1.0.0" },
    "source": { "type": "string" },
    "sourceSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "provisionNamespace": { "const": "kc" },
    "provisionCount": { "type": "integer", "minimum": 1 },
    "derivedFrom": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["predecessor", "successor"],
        "properties": {
          "predecessor": { "type": "string" },
          "successor": { "type": "string" }
        },
        "additionalProperties": false
      }
    },
    "retiredIds": {
      "type": "array",
      "items": { "type": "string" },
      "uniqueItems": true
    }
  },
  "additionalProperties": false
}
