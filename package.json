{
  "name": "code-constitution-bootstrap",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25",
    "npm": ">=11"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "format": "prettier --check . --ignore-unknown",
    "format:write": "prettier --write . --ignore-unknown",
    "lint": "eslint . --max-warnings=0 && markdownlint-cli2 \"**/*.md\" \"#.licensing-policy/**\" \"#node_modules/**\"",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check:data": "tsx src/constitution-cli/main.ts validate",
    "check": "npm run format && npm run lint && npm run typecheck && npm test && npm run check:data",
    "audit:dependencies": "npm audit"
  },
  "dependencies": {
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "remark-gfm": "4.0.1",
    "remark-parse": "11.0.0",
    "unified": "11.0.5"
  },
  "devDependencies": {
    "@eslint/js": "9.32.0",
    "@types/node": "24.1.0",
    "eslint": "9.32.0",
    "eslint-config-prettier": "10.1.8",
    "markdownlint-cli2": "0.23.2",
    "prettier": "3.6.2",
    "tsx": "4.20.3",
    "typescript": "5.8.3",
    "typescript-eslint": "8.38.0",
    "vitest": "3.2.7"
  },
  "packageManager": "npm@11.18.0",
  "allowScripts": {
    "esbuild@0.25.12": true,
    "esbuild@0.28.1": true
  }
}
