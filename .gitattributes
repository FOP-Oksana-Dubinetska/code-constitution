# Repository-wide text policy
# All detected text files use LF in the repository and working tree.
* text=auto eol=lf

# Git metadata and patch files
.gitattributes text eol=lf
.gitignore text eol=lf
.editorconfig text eol=lf
*.diff text eol=lf
*.patch text eol=lf

# Shell / Unix scripts
*.sh text eol=lf
*.bash text eol=lf
*.zsh text eol=lf

# Node / JavaScript / TypeScript
*.js text eol=lf
*.cjs text eol=lf
*.mjs text eol=lf
*.ts text eol=lf
*.jsx text eol=lf
*.tsx text eol=lf
*.json text eol=lf

# Configuration / CI
*.yml text eol=lf
*.yaml text eol=lf
*.toml text eol=lf
*.env text eol=lf

# Documentation / web
*.html text eol=lf
*.css text eol=lf
*.scss text eol=lf
*.md text eol=lf
*.svg text eol=lf

# GitHub infrastructure
.github/** text eol=lf

# Windows scripts
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Binary files: never normalize
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.pdf binary
*.zip binary
*.gz binary
*.tgz binary
*.7z binary
*.woff binary
*.woff2 binary
*.ttf binary
*.otf binary
